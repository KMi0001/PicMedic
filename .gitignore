# Python
__pycache__/
*.pyc
.pytest_cache/

# Build artifacts (PicMedic.spec is kept — documents the exact build flags)
build/
dist/

# Runtime data
logs/
임시휴지통/

# Sample/test data generated locally
test_samples/

# Local scratch/debug files
_scratch/

# 화질 개선 프로토타입(experiments/upscale_prototype) — 코드는 추적하되
# 가상환경, 사전학습 모델 가중치, Real-ESRGAN 실행 파일(합쳐서 수십MB, 다운로드로
# 다시 받을 수 있음)은 제외
experiments/upscale_prototype/.venv/
experiments/upscale_prototype/models/*.pb
experiments/upscale_prototype/realesrgan/

# 카테고리 찾기(core/category_finder.py)용 CLIP ONNX 체크포인트 —
# scripts/export_clip_onnx_assets.py로 다시 받을 수 있어 git엔 커밋하지 않음
assets/photo_category/

# 얼굴 복원 프로토타입(experiments/restore_prototype) — 가상환경과, 검증에만
# 쓰고 vendor/로 필요한 부분만 옮겨온 원본 클론들은 추적 제외
experiments/restore_prototype/.venv/
experiments/restore_prototype/.venv_rf/
experiments/restore_prototype/NAFNet_src/
experiments/restore_prototype/RestoreFormerPP_src/
experiments/restore_prototype/basicsr_src/
experiments/restore_prototype/models/*.pth
experiments/restore_prototype/test_images/out_*.png

# 도시별 정리 프로토타입(experiments/city_organize_prototype) — 가상환경과
# 실행 중 생성되는 합성 테스트 사진/스크린샷은 추적 제외
experiments/city_organize_prototype/.venv/
experiments/city_organize_prototype/sample_photos/
experiments/city_organize_prototype/screenshot*.png

# 디노이즈 안전장치 실측(experiments/denoise_safety_prototype) — 스크립트가
# 실행 중 만드는 합성 노이즈 테스트 이미지는 추적 제외(코드는 추적)
experiments/denoise_safety_prototype/_work/

# 골드셋 비교 리포트(experiments/restore_quality_goldset) — compare.py가
# 실행 때마다 만드는 원본|결과 비교 이미지는 추적 제외(스크립트는 추적)
experiments/restore_quality_goldset/_output/

# geocoder LGPL 교체 검증(experiments/geocoder_license_prototype) — 실측용으로
# 복사해둔 CSV(assets/geonames_cities1000.csv와 완전히 동일, 7.8MB)는 중복
# 커밋하지 않는다(스크립트는 추적)
experiments/geocoder_license_prototype/rg_cities1000.csv

# CLIP ONNX 변환 실측(experiments/clip_onnx_prototype) — 실행 때마다 만드는
# 합성 벤치마크 이미지·ONNX 변환 결과물(최대 수백MB~1GB대)은 추적 제외(스크립트는 추적).
# user_photos/는 검증용으로 넣는 실제 개인 사진 — 절대 커밋하지 않음.
experiments/clip_onnx_prototype/_synthetic/
experiments/clip_onnx_prototype/*.onnx
experiments/clip_onnx_prototype/user_photos/

# 정리 허브 리디자인 목업(experiments/organize_hub_redesign_mockup) — 실행할
# 때마다 다시 만들 수 있는 스크린샷만 추적 제외(스크립트는 추적). 옵션 A가
# 2026-09-13 gui/result_screen.py에 실제로 적용됨.
experiments/organize_hub_redesign_mockup/*.png

